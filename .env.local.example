# Lead Extractor — API Keys
# Copy this file to .env.local and fill in your keys.

# REQUIRED: Google Places API Key
# Get it from: https://console.cloud.google.com (enable Places API)
GOOGLE_PLACES_API_KEY=""

# OPTIONAL: Hunter.io API Key (for email enrichment)
# Get it from: https://hunter.io
# HUNTER_API_KEY=""

# OPTIONAL: CRM (Idea Leads Hub) — para enviar leads con un click
CRM_API_URL="https://crm.juancode.dev"
CRM_API_EMAIL=""
CRM_API_PASSWORD=""
